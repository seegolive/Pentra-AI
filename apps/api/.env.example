# Pentra AI — apps/api environment variables (example)
# Copy to .env and fill in your values.

DATABASE_URL=postgresql+asyncpg://pentra:pentra@localhost:5432/pentra
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_KNOWLEDGE=knowledge
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=qwen2.5-coder:32b
OLLAMA_MODEL_REASONING=qwen3:32b
OLLAMA_MODEL_FAST=qwen3:8b
OLLAMA_MODEL_EMBEDDING=bge-m3
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ──────────────────────────────────────────────────────────────
# BURP SUITE PRO MCP INTEGRATION
# ──────────────────────────────────────────────────────────────
# Burp Suite Pro harus berjalan di host machine.
# MCP extension harus terinstall dan enabled.
#
# Setup:
# 1. Buka Burp Suite Pro
# 2. Extensions → BApp Store → search "MCP Server" → Install
# 3. Tab MCP muncul → centang "Enabled"
# 4. Default port: 9876
#
# Test koneksi:
#   curl http://127.0.0.1:9876
#
# Jika worker berjalan di host langsung (development):
BURP_MCP_URL=http://127.0.0.1:9876
#
# Jika worker berjalan di Docker container:
# BURP_MCP_URL=http://host.docker.internal:9876
#
# Set false jika Burp tidak tersedia (agent tetap berjalan tanpa Burp):
BURP_MCP_ENABLED=true

# ──────────────────────────────────────────────────────────────
# SCAN BEHAVIOR — Per-subdomain sequential mode (Sprint 45)
# ──────────────────────────────────────────────────────────────
# PENTRA_SUBDOMAIN_SEQUENTIAL=true  → scan satu subdomain per kali:
#   passive (exposure/misconfig) → sleep → active (vuln/cve/sqli) → sleep → next subdomain.
#   Mencegah traffic burst, memungkinkan per-host rate-limit + WAF profiling.
#   Direkomendasikan untuk bug bounty dan engagements dengan WAF ketat.
#
# PENTRA_SUBDOMAIN_SEQUENTIAL=false (default) → semua tools berjalan concurrent.
#   Lebih cepat (~5x) tapi traffic lebih besar — cocok untuk lab/CTF.
#
PENTRA_SUBDOMAIN_SEQUENTIAL=false
#
# Jeda antar subdomain (detik). Hanya aktif saat SEQUENTIAL=true.
# Rate limit yang terdeteksi secara otomatis akan menggantikan nilai ini jika lebih tinggi.
PENTRA_INTER_SUBDOMAIN_DELAY=5
#
# Maksimum concurrent tools DALAM satu subdomain (saat SEQUENTIAL=true):
PENTRA_CONCURRENT_CANDIDATES=3
#
# Jitter tambahan per request (milliseconds) dari engagement settings:
# Set di UI saat membuat engagement (field: request_jitter_ms)
